GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ---- Pricing microservice ----
PRICING_SERVICE_URL="http://localhost:8000"

# ---- Payments (per confirmed Payment Strategy) ----
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
LULAPAY_API_KEY=""
PAYJUSTNOW_API_KEY=""

# ---- Domains ----
NEXT_PUBLIC_SITE_URL="https://aggregates.store"
NEXT_PUBLIC_APP_URL="https://app.aggregates.store"

# ---- Group / billing ----
GROUP_VAT_NUMBER="REPLACE_WITH_BESBPO_GROUP_VAT_NUMBER"

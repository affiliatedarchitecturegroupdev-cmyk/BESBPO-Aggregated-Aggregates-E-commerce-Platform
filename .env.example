# ---- Database (Supabase Postgres in production; local docker-compose for dev) ----
DATABASE_URL="postgresql://aggregates:aggregates_dev@localhost:5432/aggregates_store"
DIRECT_URL="postgresql://aggregates:aggregates_dev@localhost:5432/aggregates_store"

# ---- Cache / queues (Upstash Redis in production) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (Email/Google/Microsoft — confirmed SSO set) ----

# ---- Database (Supabase Postgres in production; local docker-compose for dev) ----
DATABASE_URL="postgresql://aggregates:aggregates_dev@localhost:5432/aggregates_store"
DIRECT_URL="postgresql://aggregates:aggregates_dev@localhost:5432/aggregates_store"

# ---- Cache / queues (Upstash Redis in production) ----
REDIS_URL="redis://localhost:6379"

# ---- Auth (Email/Google/Microsoft — confirmed SSO set) ----
AUTH_SECRET="replace-with-a-long-random-string"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
MICROSOFT_CLIENT_ID=""
MICROSOFT_CLIENT_SECRET=""

# ---- Document storage (compliance documents) ----
# Supabase Storage in production (private bucket). Leave blank locally to store
# files under apps/api/.storage instead.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="compliance-documents"

# ---- Pricing microservice ----
PRICING_SERVICE_URL="http://localhost:8000"

# ---- Payment gateways (apps/api/src/payment-gateway/adapters) ----
# PayJustNow, Happy Pay and Float route through Peach — no keys of their own.
# /admin/payments shows which gateways are still missing credentials.
PAYFAST_MERCHANT_ID=""
PAYFAST_MERCHANT_KEY=""
PAYFAST_PASSPHRASE=""
PEACH_ENTITY_ID=""
PEACH_AUTH_TOKEN=""
OZOW_SITE_CODE=""
OZOW_PRIVATE_KEY=""
OZOW_API_KEY=""
STITCH_CLIENT_ID=""
STITCH_CLIENT_SECRET=""
LULAPAY_API_KEY=""
LULAPAY_MERCHANT_ID=""

# ---- WhatsApp Business API (channels/whatsapp) ----
# Replies are logged instead of sent until the phone number id and token are set;
# the webhook refuses deliveries until the app secret is set.
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ---- Notifications (notifications/, docs/notifications.md) ----
# Emails are logged (and resendable from Admin -> Notifications) until all three are set.
EMAIL_PROVIDER=""        # resend | postmark | sendgrid
EMAIL_API_KEY=""
EMAIL_FROM=""            # e.g. Aggregated Aggregates <orders@aggregates.store>
EMAIL_REPLY_TO=""        # optional, e.g. sales@besbpo.co.za
# Staff alert inboxes until they're managed in Admin -> Notifications (comma-separated).
STAFF_NOTIFICATION_EMAILS=""
# WhatsApp order/quote updates use the WhatsApp Business credentials above plus approved templates.
WHATSAPP_TEMPLATE_LANGUAGE="en"

# ---- Domains ----
NEXT_PUBLIC_SITE_URL="https://aggregates.store"
NEXT_PUBLIC_APP_URL="https://app.aggregates.store"

# ---- Group / billing ----
GROUP_VAT_NUMBER="REPLACE_WITH_BESBPO_GROUP_VAT_NUMBER"
# Tax invoices are only issued once GROUP_VAT_NUMBER is real AND this confirms
# storefront prices already include VAT (so invoices match what buyers paid).
PRICES_INCLUDE_VAT=""
# Optional: printed on order confirmations for EFT payers (multi-line; bank, account, branch code).
EFT_BANKING_DETAILS=""

// Aggregated Aggregates — E-Commerce Platform
// Core data model, matching the confirmed model set in the Technical &
// Product Specification. Naming follows the Prisma convention already used
// on the Roofsteel and Bricksplaza platforms.
//
// IMPORTANT: the confirmed platform decision is a broker/network supplier
// model — an approved partner-supplier network, NO owned yards or inventory.
// There is deliberately no StockLevel / StockMovement model here — see
// AGENTIC_RULES.md before adding one.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Auth & accounts
// ---------------------------------------------------------------------------

enum UserRole {
  CUSTOMER
  COMPANY_ADMIN
  STAFF
  ADMIN
  PARTNER // a plant-hire / site-services partner's portal login (hirePartnerId)
}

enum OAuthProvider {
  GOOGLE
  MICROSOFT
  FACEBOOK
  X
  INSTAGRAM
}

model User {
  id                String            @id @default(cuid())
  email             String            @unique
  name              String?
  passwordHash      String? // null for OAuth-only users (Email/Google/Microsoft SSO)
  role              UserRole          @default(CUSTOMER)
  companyId         String?
  company           Company?          @relation(fields: [companyId], references: [id])
  oauthAccounts     OAuthAccount[]
  quotes            Quote[]
  orders            Order[]
  deliveryAddresses DeliveryAddress[]
  hirePartnerId     String?
  hirePartner       HirePartner?      @relation(fields: [hirePartnerId], references: [id], onDelete: SetNull)
  bookings          Booking[]
  insightsViews     InsightsView[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model OAuthAccount {
  id                String        @id @default(cuid())
  provider          OAuthProvider
  providerAccountId String
  userId            String
  user              User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@unique([provider, providerAccountId])
}

// ---------------------------------------------------------------------------
// Trade accounts & tiering
// ---------------------------------------------------------------------------

enum CustomerTierName {
  RETAIL
  CONTRACTOR_TRADE
  VOLUME_CIVIL_BULK
}

model CustomerTier {
  id                String           @id @default(cuid())
  name              CustomerTierName @unique
  discountPercent   Decimal          @db.Decimal(5, 2)
  minimumOrderM3    Float? // Volume/Civil Bulk tier threshold (>=10m3 routes to RFQ)
  requiresPoInvoice Boolean          @default(false)
  companies         Company[]        @relation("CompanyTier")
  requestedBy       Company[]        @relation("RequestedTier")
}

/// Trade account applications start PENDING at Retail pricing; staff
/// approve them onto the requested tier (8% / 15% off list is never
/// self-service).
enum CompanyStatus {
  PENDING
  APPROVED
  DECLINED
}

model Company {
  id                   String            @id @default(cuid())
  name                 String
  registrationNumber   String?
  vatNumber            String?
  tierId               String
  tier                 CustomerTier      @relation("CompanyTier", fields: [tierId], references: [id])
  status               CompanyStatus     @default(PENDING)
  requestedTierId      String?
  requestedTier        CustomerTier?     @relation("RequestedTier", fields: [requestedTierId], references: [id])
  contactPhone         String?
  applicationNotes     String?
  reviewNotes          String?
  reviewedAt           DateTime?
  standingAgreementRef String? // e.g. "KZN Civil — active"
  deliveryAddresses    DeliveryAddress[]
  users                User[]
  quotes               Quote[]
  orders               Order[]
  invoices             Invoice[]
  statements           Statement[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
}

/// A saved delivery site: shared by a trade company's users (companyId), or a
/// personal one for a customer without a company (userId). Exactly one is set.
model DeliveryAddress {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String
  addressLine1 String
  addressLine2 String?
  city         String
  province     String
  postalCode   String
  latitude     Float?
  longitude    Float?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())

  @@index([companyId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Catalogue & pricing
// ---------------------------------------------------------------------------

/// catalogueGroup: "core" is the 9-category, 48-SKU aggregate catalogue from
/// the pricing framework workbook; "b2b-bulk" is the B2B Bulk &
/// Infrastructure expansion (cement/binders, mortars/grouts/admixtures),
/// sold per packaged unit — see B2B_BULK_CATALOGUE.md.
model Category {
  id             String    @id @default(cuid())
  slug           String    @unique
  name           String
  description    String?
  sortOrder      Int       @default(0)
  catalogueGroup String    @default("core")
  products       Product[]
}

model Product {
  id                        String               @id @default(cuid())
  sku                       String               @unique
  slug                      String               @unique
  name                      String
  categoryId                String
  category                  Category             @relation(fields: [categoryId], references: [id])
  gradingStandard           String? // e.g. "SANS 1200-G", "SANS 1083", "COLTO/TRH14"
  unitsOfSale               UnitOfSale[] // from the workbook's "Unit of Sale" column; the pricing service refuses any other unit
  description               String?
  // Cement taxonomy as product attributes (CEMENT_MASTER_CATALOGUE.md) — cement only.
  manufacturer              String?
  brand                     String?
  cementFamily              String? // General Purpose | High Strength | Masonry | Road Stabilisation | Precast & Concrete Products
  cementClass               String? // e.g. "32,5N", "52,5R", "22,5X"
  cementType                String? // SANS 50197-1 CEM designation, where documented
  regionNote                String? // only for region-dependent SKUs (e.g. AfriSam HSC)
  specialistCharacteristics String[]             @default([])
  // Ready-mix concrete (READY_MIX_CATALOGUE.md) — ready-mix only.
  strengthGradeMPa          Int? // the product IS the strength grade
  mixType                   String?
  minimumLoadM3             Decimal?             @db.Decimal(6, 2) // a full mixer-truck load
  // Steel (STEEL_CATALOGUE.md) — steel only.
  steelFamily               String? // e.g. "Rebar — high-tensile (Y)", "Welded mesh", "Structural steel"
  steelGrade                String? // e.g. "450 MPa (Y)"
  diameterMm                Int? // bar diameter
  massKgPerM                Decimal?             @db.Decimal(7, 3) // SANS 920 nominal mass
  sectionSize               String? // e.g. "6.0 x 2.4 m sheet", "40 x 40 x 3 mm"
  readyMixPriceBand         ReadyMixPriceBand?
  images                    ProductImage[]
  priceBand                 PriceBand?
  packagedPriceBands        PackagedPriceBand[] // CAT-10/CAT-11 packaged goods and CAT-15..18 steel
  complianceDocuments       ComplianceDocument[]
  quoteLineItems            QuoteLineItem[]
  orderLineItems            OrderLineItem[]
  isActive                  Boolean              @default(true) // staff can hide a product from the storefront
  featuredRank              Int? // set = shown in the homepage's featured row, lowest first
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
}

/// Ready-mix concrete (CAT-12): one per-m³ price per strength grade. Same
/// discipline as the other price bands: no listPricePerM3 unless
/// pricingStatus is "Ready — benchmarked" (AGENTIC_RULES.md rule 1).
model ReadyMixPriceBand {
  id                   String   @id @default(cuid())
  productId            String   @unique
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  marketBenchmarkPrice Decimal? @db.Decimal(10, 2)
  costBasisPercent     Decimal  @db.Decimal(5, 2) // cost proxy = the benchmark (100) until supplier terms are known
  markupPercent        Decimal  @db.Decimal(5, 2)
  listPricePerM3       Decimal? @db.Decimal(10, 2)
  pricingStatus        String
  sourceNote           String?
  updatedAt            DateTime @updatedAt
}

enum PumpType {
  STATIC_LINE
  BOOM
}

/// Concrete pump hire — priced separately from the concrete (a service, not
/// a per-m³ material). Quote-only until a written supplier quote is loaded.
model ReadyMixPumpOption {
  id              String   @id @default(cuid())
  code            String   @unique // e.g. PUMP-BOOM-36M
  name            String
  pumpType        PumpType
  boomLengthM     Int?
  capacityM3PerHr Int? // supplier-published capacity, not a guarantee
  callOutFee      Decimal? @db.Decimal(10, 2)
  ratePerM3       Decimal? @db.Decimal(10, 2)
  pricingStatus   String
  sourceNote      String?
  isActive        Boolean  @default(true)
  updatedAt       DateTime @updatedAt
}

/// Product photography uploaded by staff, stored in object storage and
/// served publicly through the API.
/// Whether a product photo may be shown publicly. Staff uploads are CLEARED
/// (their own photography); sourced candidates arrive PERMISSION_PENDING and
/// only reach the storefront once staff record the source's permission.
/// REMOVED keeps a deleted imported photo's record so the deploy import
/// doesn't bring it back.
enum ImageLicence {
  CLEARED
  PERMISSION_PENDING
  REMOVED
}

model ProductImage {
  id          String       @id @default(cuid())
  productId   String
  product     Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  storageKey  String       @unique // "seed:<file>" for images served from the repository's sourced set
  contentType String
  sizeBytes   Int
  altText     String?
  sortOrder   Int          @default(0)
  licence     ImageLicence @default(CLEARED)
  sourceName  String? // who owns the photo, for sourced candidates
  sourceUrl   String?
  sourceNote  String? // flags and sourcing notes shown to staff
  importKey   String?      @unique // "<sku>:<file>" for the deploy import
  // Open-licence photos (Wikimedia Commons etc.): the licence and, when it
  // requires one, the credit the storefront must show next to the photo.
  licenceName String? // e.g. "CC BY-SA 4.0", "CC0", "Public domain"
  licenceUrl  String?
  credit      String? // required attribution ("Jane Doe, via Wikimedia Commons"); null when none is required
  createdAt   DateTime     @default(now())

  @@index([productId])
  @@index([sourceName])
}

/// Editable storefront copy (announcement bar, homepage hero, trade promo),
/// one JSON document per key. The API validates each key's shape; the
/// storefront falls back to built-in copy for any key not yet saved.
model SiteContent {
  key         String   @id
  data        Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

/// Category-level bulk density, base cost, markup %, and bag premium
/// multiplier — mirrors the Category Markup Bands sheet in the pricing xlsx.
/// Seeded from services/pricing/data/pricing_framework.json (generated from
/// the workbook); the pricing service, not these columns, prices orders.
model PriceBand {
  id                   String   @id @default(cuid())
  productId            String   @unique
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  bulkDensityKgPerM3   Float // converts tons <-> m3 for this product
  baseCostPerTon       Decimal  @db.Decimal(10, 2)
  markupPercent        Decimal  @db.Decimal(5, 2)
  listPricePerTon      Decimal  @db.Decimal(10, 2)
  listPricePerM3       Decimal  @db.Decimal(10, 2)
  bagPremiumMultiplier Float? // null = not sold bagged
  bagWeightKg          Float?
  listPricePerBag      Decimal? @db.Decimal(10, 2)
  updatedAt            DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Delivery & the partner-supplier network
// ---------------------------------------------------------------------------

/// Pricing for CAT-10 (Cement & Hydraulic Binders) and CAT-11 (Mortars,
/// Grouts & Admixtures), sold per packaged unit — no ton <-> m3 conversion.
/// Mirrors the B2B pricing workbook's "Category Markup Bands" sheet,
/// including its gaps: where there is no real benchmark, costPerUnit and
/// listPricePerUnit stay null and pricingStatus says why. Only a unit that
/// is "Ready — benchmarked" with a list price is ever priced to a customer;
/// everything else goes to a quote (AGENTIC_RULES.md rules 1 and 10).
model PackagedPriceBand {
  id                   String     @id @default(cuid())
  productId            String
  product              Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  unit                 UnitOfSale // one of the packaged (or steel) units
  weightKg             Decimal?   @db.Decimal(10, 3) // mass of one unit, where known (steel lengths, coils)
  marketBenchmarkPrice Decimal?   @db.Decimal(10, 2)
  costBasisPercent     Decimal    @db.Decimal(5, 2) // assumption — % of benchmark, confirm with supplier
  costPerUnit          Decimal?   @db.Decimal(10, 2)
  markupPercent        Decimal    @db.Decimal(5, 2)
  listPricePerUnit     Decimal?   @db.Decimal(10, 2)
  pricingStatus        String // "Ready — benchmarked" | "Provisional — confirm w/ supplier" | "Quote-only — no retail benchmark" | "BLOCKED — no benchmark"
  sourceNote           String?
  updatedAt            DateTime   @updatedAt

  @@unique([productId, unit])
}

enum DeliveryBandLabel {
  INCLUDED_0_30
  BAND_30_60
  BAND_60_100
  QUOTE_100_PLUS
}

enum LoadSize {
  M3_6
  M3_10
  M3_14_PLUS
}

model DeliveryBand {
  id          String            @id @default(cuid())
  label       DeliveryBandLabel
  loadSize    LoadSize?
  minKm       Float
  maxKm       Float? // null = open-ended -> routes to RFQ
  flatFee     Decimal?          @db.Decimal(10, 2) // null = quoted individually (isQuoteOnly = true)
  isQuoteOnly Boolean           @default(false)
  shipments   Shipment[]
}

/// The approved partner-supplier network a delivery distance is measured
/// from. There is deliberately no owned-yard entity in this model — the
/// confirmed platform decision is a broker/network model.
///
/// Imported by staff from the supplier database CSV (never committed to the
/// public repo). Names and contacts are staff-only; the storefront shows
/// delivery points by town and province. Distances need coordinates, which
/// staff add per supplier — a supplier without them is never used for a
/// distance.
enum SupplierTier {
  TIER_1
  TIER_2
}

model SupplierLocation {
  id                String       @id @default(cuid())
  externalId        String?      @unique // supplier_id in the supplier database, e.g. "SUP-001"
  name              String
  tier              SupplierTier @default(TIER_1)
  province          String
  city              String // town shown publicly for the delivery point
  address           String?
  latitude          Float?
  longitude         Float?
  categorySlugs     String[] // storefront category slugs this supplier can supply
  isVerifiedPartner Boolean      @default(true) // false = researched lead, not yet contacted or qualified
  isGroupEntity     Boolean      @default(false) // a Besbpo Group company (e.g. Precast Direct) — intercompany, not arm's-length
  sourceUrl         String? // where a researched lead came from
  productNotes      String? // e.g. "CAT-01 (G1–G5), CAT-02 (13.2mm, 19mm Andesite)"
  contactName       String?
  contactPhone      String?
  approvedSince     DateTime?
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @default(now()) @updatedAt

  fulfilledOrders Order[]

  @@index([province])
}

// ---------------------------------------------------------------------------
// RFQ / bulk quote flow
// ---------------------------------------------------------------------------

enum QuoteStatus {
  DRAFT
  SUBMITTED
  QUOTED
  ACCEPTED
  DECLINED
  EXPIRED
}

enum QuoteReasonCode {
  VOLUME_CIVIL_BULK
  DELIVERY_OVER_100KM
  BOTH
  DELIVERY_NOT_PRICED // small-load or bagged delivery beyond 30km
  CUSTOMER_REQUEST // priceable at checkout, but the customer asked for a quote
  PRICE_ON_REQUEST // packaged goods without a confirmed price, or bulk-format packaged delivery
}

enum UnitOfSale {
  BULK_TON
  BULK_M3
  BAGGED
  // Packaged goods (CAT-10/CAT-11) — see PackagedPriceBand
  BAG_25KG
  BAG_50KG
  BULK_BAG_1_5T
  BULK_TANKER_PER_TON
  DRUM_210L
  IBC_TOTE_1000L
  // Steel (CAT-15..18, STEEL_CATALOGUE.md) — also priced through PackagedPriceBand
  LENGTH_6M
  LENGTH_12M
  TONNE
  SHEET
  ROLL
  COIL
  PACK
  EACH
}

/// Captures quote-only orders before they become a priced Order — the RFQ
/// path for Volume/Civil Bulk tier orders (>=10m3) and any delivery beyond
/// 100km, which the pricing framework already treats as quote-only rather
/// than checkout-priced.
model Quote {
  id                 String          @id @default(cuid())
  reference          String          @unique @default(cuid())
  userId             String?
  user               User?           @relation(fields: [userId], references: [id])
  companyId          String?
  company            Company?        @relation(fields: [companyId], references: [id])
  status             QuoteStatus     @default(DRAFT)
  reasonCode         QuoteReasonCode
  reasons            String[] // the pricing service's quote-only reasons, verbatim
  contactName        String?
  contactEmail       String?
  contactPhone       String?
  whatsappUpdates    Boolean         @default(false) // requester opted in to quote updates on WhatsApp
  companyName        String?
  projectName        String?
  deliveryAddress    String?
  deliveryProvince   String?
  deliveryDistanceKm Float?
  lineItems          QuoteLineItem[]
  notes              String?
  estimatedSubtotal  Decimal?        @db.Decimal(12, 2) // materials at the requester's tier, excl. delivery
  quotedTotal        Decimal?        @db.Decimal(12, 2)
  staffNotes         String?
  quotedAt           DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  respondedAt        DateTime? // when the customer accepted or declined
}

model QuoteLineItem {
  id                 String     @id @default(cuid())
  quoteId            String
  quote              Quote      @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId          String
  product            Product    @relation(fields: [productId], references: [id])
  unitOfSale         UnitOfSale
  quantity           Float
  estimatedUnitPrice Decimal?   @db.Decimal(10, 2)
}

// ---------------------------------------------------------------------------
// Orders, shipment & compliance
// ---------------------------------------------------------------------------

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum Carrier {
  BESFLEET
  EXTERNAL_PARTNER
}

/// Where an order came from. INSTAGRAM/FACEBOOK are referral attribution
/// only — Meta dropped in-app checkout in 2025, so those buyers land on the
/// normal storefront. WHATSAPP is the one channel with its own intake.
enum OrderChannel {
  WEBSITE
  WHATSAPP
  INSTAGRAM_REFERRAL
  FACEBOOK_REFERRAL
}

model Order {
  id                    String                @id @default(cuid())
  orderNumber           String                @unique
  channel               OrderChannel          @default(WEBSITE)
  // Delivery details captured at checkout.
  deliveryAddress       String?
  deliveryProvince      String?
  deliveryDistanceKm    Float?
  distanceSource        String? // "LOCATION" (buyer's pin to the nearest supplier) or "CUSTOMER" (entered)
  contactPhone          String?
  whatsappUpdates       Boolean               @default(false) // buyer opted in to order updates on WhatsApp
  notes                 String?
  whatsappConversation  WhatsAppConversation?
  userId                String?
  user                  User?                 @relation(fields: [userId], references: [id])
  companyId             String?
  company               Company?              @relation(fields: [companyId], references: [id])
  status                OrderStatus           @default(PENDING)
  lineItems             OrderLineItem[]
  shipment              Shipment?
  invoice               Invoice?
  documents             ComplianceDocument[]
  subtotal              Decimal               @db.Decimal(12, 2)
  deliveryFee           Decimal               @db.Decimal(10, 2)
  total                 Decimal               @db.Decimal(12, 2)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  // Reporting fields (ANALYTICS.md). A sale counts from paidAt (payment confirmed).
  customerTier          CustomerTierName? // tier the order was priced at
  deliveryLoadSize      LoadSize? // load size the delivery fee was priced for (null = bagged/no tipper)
  paidAt                DateTime?
  cancelledAt           DateTime?
  paymentMethod         PaymentMethodKey? // method chosen at payment (or confirmed by staff)
  fulfilledBySupplierId String?
  fulfilledBySupplier   SupplierLocation?     @relation(fields: [fulfilledBySupplierId], references: [id], onDelete: SetNull)
  isTest                Boolean               @default(false) // excluded from reporting
  timestampsEstimated   Boolean               @default(false) // paidAt/cancelledAt backfilled for orders placed before they were recorded
  refunds               Refund[]
}

/// Confirmed orders — unit-of-sale (bulk/bag) and quantity recorded per line.
model OrderLineItem {
  id            String      @id @default(cuid())
  orderId       String
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  unitOfSale    UnitOfSale
  quantity      Float
  unitPrice     Decimal     @db.Decimal(10, 2)
  lineTotal     Decimal     @db.Decimal(12, 2)
  // Profit snapshot taken when the order is placed (ANALYTICS.md) — never recalculated.
  listUnitPrice Decimal?    @db.Decimal(10, 2) // list price before the tier discount
  unitCost      Decimal?    @db.Decimal(10, 2) // list / (1 + markup), from the pricing service
  pricingFamily String? // AGGREGATE | CEMENT_BAGGED | CEMENT_BULK | READY_MIX
  costSource    CostSource? // SNAPSHOT at checkout; ESTIMATED when backfilled from price bands
}

/// Delivery tracking — carrier (Besfleet or one of the 15+ external tipper
/// partners), distance band, and delivery fee applied.
model Shipment {
  id                  String              @id @default(cuid())
  orderId             String              @unique
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  carrier             Carrier
  externalPartnerName String? // populated when carrier = EXTERNAL_PARTNER
  distanceBandId      String?
  distanceBand        DeliveryBand?       @relation(fields: [distanceBandId], references: [id])
  distanceKm          Float?
  deliveryFeeApplied  Decimal             @db.Decimal(10, 2)
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  trackingRef         String?
  // What the delivery cost us, ex VAT (ANALYTICS.md): the actual haulier amount, else the standard rate.
  deliveryCost        Decimal?            @db.Decimal(10, 2)
  deliveryCostSource  DeliveryCostSource?
  deliveryCostNote    String?
}

enum ComplianceDocType {
  SANS_REFERENCE
  CERTIFICATE_OF_ANALYSIS
  OTHER
}

/// SANS / COA (Certificate of Analysis) attachments per product or batch —
/// SANS 1200-G (G1-G10 grading), SANS 1083 (concrete aggregate), COLTO/TRH14
/// (road-building material).
///
/// A product-level document (orderId null) is public and shown on the
/// product page and on every order of that product. A document attached to
/// an order (a batch COA for that delivery) is visible only to the order's
/// buyer and staff. Files live in object storage under storageKey.
model ComplianceDocument {
  id             String            @id @default(cuid())
  productId      String
  product        Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  title          String
  standard       String
  documentType   ComplianceDocType
  batchReference String?
  storageKey     String            @unique
  fileName       String
  contentType    String
  sizeBytes      Int
  issuedAt       DateTime?
  expiresAt      DateTime?
  uploadedById   String?
  createdAt      DateTime          @default(now())

  @@index([productId])
  @@index([orderId])
}

// ---------------------------------------------------------------------------
// Billing — Besbpo Group company VAT from day one (confirmed decision)
// ---------------------------------------------------------------------------

enum InvoiceStatus {
  UNPAID
  PAID
  OVERDUE
  VOID
}

model Invoice {
  id                String        @id @default(cuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  companyId         String?
  company           Company?      @relation(fields: [companyId], references: [id])
  statementId       String?
  statement         Statement?    @relation(fields: [statementId], references: [id])
  invoiceNumber     String        @unique
  vatNumberBilled   String // Besbpo Group VAT number — this division bills under group VAT, not its own registration
  amountDue         Decimal       @db.Decimal(12, 2) // the invoice total, VAT included
  // Snapshot at issue, so an issued tax invoice never changes afterwards.
  billedToName      String?
  billedToAddress   String?
  billedToVatNumber String?
  amountExVat       Decimal?      @db.Decimal(12, 2)
  vatAmount         Decimal?      @db.Decimal(12, 2)
  vatRatePercent    Decimal?      @db.Decimal(5, 2)
  pricesIncludedVat Boolean? // how the order's prices were treated when VAT was worked out
  status            InvoiceStatus @default(UNPAID)
  dueDate           DateTime?
  paidAt            DateTime?
  createdAt         DateTime      @default(now())
}

/// Periodic PO-based billing rollup for Volume/Civil Bulk tier standing
/// agreements — one statement groups several invoices for the same company.
model Statement {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  periodStart DateTime
  periodEnd   DateTime
  totalDue    Decimal   @db.Decimal(12, 2)
  invoices    Invoice[]
  issuedAt    DateTime  @default(now())
}

// ---------------------------------------------------------------------------
// Merchandising: the scaled-down ad system
// ---------------------------------------------------------------------------

enum PromotionSlot {
  HOMEPAGE_SECONDARY_BANNER
  CATEGORY_TOP_BANNER
  QUOTE_FLOW_UPSELL
  FOOTER_STRIP
  GROUP_CROSS_SELL
}

/// A handful of staff-managed banner slots, not a targeting/bidding engine.
/// The first active promotion in a slot (lowest sortOrder, newest on a tie,
/// inside its date window) is the one shown. A promotion can target one
/// category or industry listing; targeted creative beats untargeted.
/// imageUrl is a media-library id ("media:<id>", apps/web/src/data/media.ts),
/// an uploaded asset ("upload:<MediaAsset id>") or an https image URL.
model Promotion {
  id        String        @id @default(cuid())
  slot      PromotionSlot
  title     String
  imageUrl  String
  linkUrl   String?
  startsAt  DateTime?
  endsAt    DateTime?
  isActive  Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  categorySlug String? // targets one category listing (CATEGORY_TOP_BANNER)
  industrySlug String? // targets one industry listing (CATEGORY_TOP_BANNER)
  stats        PromotionStat[]

  @@index([slot, isActive])
}

/// Daily impressions and clicks per promotion — counts only, no visitor data.
model PromotionStat {
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  day         DateTime  @db.Date
  impressions Int       @default(0)
  clicks      Int       @default(0)

  @@id([promotionId, day])
}

/// Staff-uploaded images for promotions and blog covers, kept in the same
/// storage as compliance documents and served publicly by id.
model MediaAsset {
  id          String   @id @default(cuid())
  storageKey  String   @unique
  contentType String
  sizeBytes   Int
  label       String // what staff called it, for picking it later
  createdAt   DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Blog / lightweight CMS
// ---------------------------------------------------------------------------

model BlogCategory {
  id    String     @id @default(cuid())
  slug  String     @unique
  name  String
  posts BlogPost[]
}

model BlogPost {
  id            String        @id @default(cuid())
  slug          String        @unique
  title         String
  excerpt       String?
  bodyMarkdown  String        @db.Text
  coverImageUrl String? // media-library id ("media:<id>") or an https image URL
  categoryId    String?
  category      BlogCategory? @relation(fields: [categoryId], references: [id])
  authorName    String        @default("Aggregated Aggregates")
  isPublished   Boolean       @default(false)
  publishedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isPublished, publishedAt])
}

// ---------------------------------------------------------------------------
// Payments: standout tiles for the shopper, shared plumbing behind them
// ---------------------------------------------------------------------------

enum PaymentMethodKey {
  CARD
  INSTANT_EFT
  CAPITEC_PAY
  APPLE_PAY
  GOOGLE_PAY
  SAMSUNG_PAY
  ZAPPER
  SNAPSCAN
  MOBICRED
  MORETYME
  PAYFLEX
  PAYJUSTNOW
  HAPPY_PAY
  FLOAT
  OZOW
  STITCH
  LULAPAY
  EFT_PO
}

enum PaymentGateway {
  PAYFAST
  PEACH
  OZOW_DIRECT
  STITCH_DIRECT
  LULAPAY_DIRECT
  MANUAL_EFT
}

/// Every payment method is its own tile on the storefront; this table is
/// the invisible routing behind each one, editable by admins so ops can
/// fail a method over (e.g. Ozow outage -> Peach) without a deploy
/// (AGENTIC_RULES.md rule 8). The gateway mapping is a researched default,
/// not a confirmed merchant setup — see PAYMENT_PROVIDER_TERMS.md.
model PaymentMethodConfig {
  id              String           @id @default(cuid())
  methodKey       PaymentMethodKey @unique
  displayName     String
  activeGateway   PaymentGateway
  fallbackGateway PaymentGateway?
  minOrderValue   Decimal?         @db.Decimal(12, 2)
  maxOrderValue   Decimal?         @db.Decimal(12, 2)
  tradeOnly       Boolean          @default(false) // Trade/Volume tiers only (LULAPAY, EFT_PO)
  isEnabled       Boolean          @default(true)
  sortOrder       Int              @default(0)
  updatedAt       DateTime         @updatedAt
}

// ---------------------------------------------------------------------------
// Social commerce: WhatsApp conversation-to-order
// ---------------------------------------------------------------------------

enum WhatsAppConversationState {
  BROWSING
  CART_DRAFT
  HANDED_TO_SALES
  PAYMENT_LINK_SENT
  PAID
  ABANDONED
}

/// The WhatsApp Business API conversation behind a chat order — the only
/// social channel with its own order intake, scoped to Retail-tier bagged
/// and small orders (AGENTIC_RULES.md rule 11). The draft cart lives here
/// until it becomes a normal Order (channel WHATSAPP); pricing and checkout
/// stay in the existing modules.
model WhatsAppConversation {
  id              String                    @id @default(cuid())
  phoneNumber     String
  state           WhatsAppConversationState @default(BROWSING)
  draftCartJson   Json?
  lastInboundText String?
  lastMessageId   String? // Meta retries webhooks; a repeated message id is ignored
  paymentLinkUrl  String?
  orderId         String?                   @unique
  order           Order?                    @relation(fields: [orderId], references: [id])
  lastMessageAt   DateTime                  @default(now())
  createdAt       DateTime                  @default(now())

  @@index([phoneNumber, state])
}

// ---------------------------------------------------------------------------
// Notifications (email + WhatsApp)
// ---------------------------------------------------------------------------

enum NotificationEvent {
  ORDER_PLACED
  ORDER_CONFIRMED
  ORDER_DISPATCHED
  ORDER_DELIVERED
  ORDER_CANCELLED
  QUOTE_RECEIVED
  QUOTE_PRICED
  QUOTE_ACCEPTED
  QUOTE_DECLINED
  TRADE_APPLICATION_RECEIVED
  TRADE_APPLICATION_APPROVED
  TRADE_APPLICATION_DECLINED
  ENQUIRY_RECEIVED
  BOOKING_QUOTED
  BOOKING_PAYMENT_CONFIRMED
  BOOKING_OFFERED
  BOOKING_PARTNER_ASSIGNED
  BOOKING_UNFULFILLED
  BOOKING_COMPLETED
  BOOKING_DISPUTED
  PAYOUT_DUE
  WEEKLY_INSIGHTS // Monday summary of last week's sales and profit, to admins only
  BENDING_SCHEDULE_RECEIVED // cut & bend: a bar bending schedule came in
  BENDING_SCHEDULE_QUOTED
  BENDING_SCHEDULE_ACCEPTED
  BENDING_SCHEDULE_DECLINED
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
}

enum NotificationAudience {
  CUSTOMER
  STAFF
  PARTNER
}

enum NotificationStatus {
  PENDING
  SENT
  LOGGED // no provider configured yet — written to the log instead of sent
  FAILED
}

/// Every email and WhatsApp message the platform sends (or would have sent),
/// so staff can see what a customer was told and resend a failed message.
model Notification {
  id                String               @id @default(cuid())
  event             NotificationEvent
  channel           NotificationChannel
  audience          NotificationAudience
  recipient         String // email address, or WhatsApp number in international format
  subject           String?
  body              String               @db.Text // plain-text body (email) or the rendered template text (WhatsApp)
  html              String?              @db.Text
  templateName      String? // WhatsApp message template
  templateParams    String[]
  status            NotificationStatus   @default(PENDING)
  provider          String?
  providerMessageId String?
  error             String?
  attempts          Int                  @default(0)
  orderId           String?
  quoteId           String?
  companyId         String?
  enquiryId         String?
  bookingId         String?
  bendingScheduleId String?
  createdAt         DateTime             @default(now())
  sentAt            DateTime?

  @@index([createdAt])
  @@index([status])
  @@index([orderId])
  @@index([quoteId])
}

/// Which channels each event uses. Customer WhatsApp starts off: Meta must
/// approve each message template before business-initiated messages send.
model NotificationSetting {
  event            NotificationEvent @id
  customerEmail    Boolean           @default(true)
  customerWhatsApp Boolean           @default(false)
  staffEmail       Boolean           @default(true)
  updatedAt        DateTime          @updatedAt
}

/// Staff inboxes that receive new-order, new-quote and trade-application alerts.
model NotificationRecipient {
  email     String   @id
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------------------------
// Careers
// ---------------------------------------------------------------------------

enum VacancyStatus {
  DRAFT
  OPEN
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  INTERNSHIP
  LEARNERSHIP
}

enum WorkplaceType {
  ON_SITE
  HYBRID
  REMOTE
}

/// A job advert on /careers. Only OPEN vacancies (before their closing date)
/// are public; staff manage them in Admin -> Careers.
model Vacancy {
  id             String           @id @default(cuid())
  slug           String           @unique
  title          String
  department     String
  location       String // "Durban, KwaZulu-Natal" or "Any province"
  employmentType EmploymentType
  workplace      WorkplaceType    @default(ON_SITE)
  summary        String // one or two sentences for the listing
  description    String // Markdown: the role, responsibilities, requirements, benefits
  salary         String? // shown as written ("Market related", "R18 000 – R22 000 per month")
  closingDate    DateTime?
  status         VacancyStatus    @default(DRAFT)
  publishedAt    DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  applications   JobApplication[]

  @@index([status, closingDate])
}

enum ApplicationStatus {
  NEW
  REVIEWING
  SHORTLISTED
  INTERVIEW
  OFFER
  HIRED
  UNSUCCESSFUL
  WITHDRAWN
}

/// A CV sent for a vacancy, or to the talent pool when vacancyId is null.
/// The CV is stored privately (same storage as compliance documents) and only
/// staff can download it. POPIA: consentAt records the applicant's consent,
/// and applications are kept for 12 months unless they agree to longer.
model JobApplication {
  id            String            @id @default(cuid())
  vacancyId     String?
  vacancy       Vacancy?          @relation(fields: [vacancyId], references: [id], onDelete: SetNull)
  fullName      String
  email         String
  phone         String
  province      String?
  town          String?
  linkedinUrl   String?
  coverNote     String?
  cvStorageKey  String            @unique
  cvFileName    String
  cvContentType String
  cvSizeBytes   Int
  consentAt     DateTime
  status        ApplicationStatus @default(NEW)
  staffNotes    String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([vacancyId, status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Newsletter
// ---------------------------------------------------------------------------

enum SubscriberAudience {
  CUSTOMER
  CONTRACTOR
  PARTNER
  OTHER
}

/// Newsletter sign-ups from the strip above the footer. POPIA s69: consentAt
/// records opt-in; every email carries the unsubscribe link (by token).
model NewsletterSubscriber {
  id               String             @id @default(cuid())
  email            String             @unique
  name             String?
  audience         SubscriberAudience @default(CUSTOMER)
  province         String?
  source           String? // the page they signed up on
  consentAt        DateTime
  unsubscribeToken String             @unique
  unsubscribedAt   DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([unsubscribedAt])
}

/// What a customer is asking about on the hire, services and project pages.
enum EnquiryKind {
  PLANT_HIRE // a wet-hire machine (PLANT_HIRE_CATALOGUE.md)
  SITE_SERVICE // haulage, rubble removal, skips, clearing, demolition
  BUSINESS_LINE // recycled loop, fill exchange, testing, diesel, small equipment
  JOB_PACK // a bundle of materials, hire and services
  ESTIMATE // a sized job from the project estimator
  PARTNER_APPLICATION // a plant or haulage operator applying to join
}

enum EnquiryStatus {
  NEW
  IN_PROGRESS
  QUOTED
  WON
  LOST
  CLOSED
}

/// Requests from the plant-hire, services, job-pack, estimator and partner
/// pages. These lines are quoted (no written partner rates yet), so a
/// request is an enquiry that sales prices with partners — not a quote on
/// catalogue SKUs. Contact details are personal information (POPIA): staff only.
model Enquiry {
  id           String        @id @default(cuid())
  reference    String        @unique // ENQ-YYMMDD-XXXX, shown to the customer
  kind         EnquiryKind
  subject      String // what it's about, e.g. "Excavator 5t" or "Fill Exchange"
  sku          String? // the machine, service or pack, when there is one
  details      Json // the form's answers (region, hire period, dates, sizes…)
  contactName  String
  contactEmail String
  contactPhone String?
  companyName  String?
  province     String?
  siteAddress  String?
  message      String?
  userId       String? // signed-in customer, if any
  status       EnquiryStatus @default(NEW)
  staffNotes   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([kind])
}

// ---------------------------------------------------------------------------
// Phase C: plant-hire & site-service bookings (Agent model)
// PLANT_HIRE_CATALOGUE.md. A booking is priced only from a partner's written
// quote (partnerAmount, quoteSource) plus the fixed commission; it is paid by
// EFT before dispatch, offered to partners (30-minute window, cascade),
// started with the customer's arrival code, signed off by the customer and
// paid out to the partner by staff after the 48-hour dispute window.
// ---------------------------------------------------------------------------

enum HirePartnerStatus {
  ONBOARDING
  ACTIVE
  SUSPENDED
}

/// A vetted plant-hire / site-services partner. Contact details are staff-only.
model HirePartner {
  id                     String             @id @default(cuid())
  name                   String
  province               String
  town                   String?
  contactName            String?
  contactEmail           String
  contactPhone           String?
  status                 HirePartnerStatus  @default(ONBOARDING)
  isGroupEntity          Boolean            @default(false) // Besbpo Group company: small tie-break in ranking only
  latitude               Float? // staff pin from a map, never guessed
  longitude              Float?
  payoutDetailsConfirmed Boolean            @default(false) // bank confirmation letter on file
  termsVersion           String? // Partner Terms version accepted in the portal (content/legal/partner-terms.md)
  termsAcceptedAt        DateTime?
  termsAcceptedById      String?
  notes                  String?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  users                  User[]
  fleet                  PartnerFleetUnit[]
  offers                 DispatchOffer[]
  bookings               Booking[]          @relation("AssignedPartner")
  preferredOn            Booking[]          @relation("PreferredPartner")
  payouts                PartnerPayout[]
}

/// One machine or service capability a partner offers in a province (sku from the plant/services catalogue).
model PartnerFleetUnit {
  id           String                     @id @default(cuid())
  partnerId    String
  partner      HirePartner                @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  sku          String
  label        String // e.g. "CAT 320D, reg ND 123-456"
  province     String
  isActive     Boolean                    @default(true)
  createdAt    DateTime                   @default(now())
  availability PartnerAvailabilityBlock[]

  @@index([sku, province])
}

/// Dates a fleet unit is unavailable (inclusive). Accepted bookings add their own block.
model PartnerAvailabilityBlock {
  id          String           @id @default(cuid())
  fleetUnitId String
  fleetUnit   PartnerFleetUnit @relation(fields: [fleetUnitId], references: [id], onDelete: Cascade)
  startsOn    DateTime         @db.Date
  endsOn      DateTime         @db.Date
  reason      String?
  bookingId   String?
  createdAt   DateTime         @default(now())

  @@index([fleetUnitId, startsOn])
}

enum BookingStatus {
  QUOTED // staff priced it from a partner's written quote; waiting for the customer
  AWAITING_PAYMENT // customer accepted; waiting for their EFT
  DISPATCHING // paid; offering to partners
  ACCEPTED // a partner accepted and is named to the customer
  IN_PROGRESS // arrival code checked on site
  COMPLETED // customer signed off; dispute window running
  CLOSED // partner paid out
  DISPUTED
  UNFULFILLED // no partner accepted; staff refund or re-quote
  DECLINED // customer declined the quote
  CANCELLED
}

enum BookingBasis {
  DAY
  WEEK
  LOAD
  SKIP
  M2
  JOB
}

model Booking {
  id                 String           @id @default(cuid())
  reference          String           @unique // BK-YYMMDD-XXXXXX
  userId             String
  user               User             @relation(fields: [userId], references: [id])
  enquiryId          String?
  sku                String
  itemName           String
  basis              BookingBasis
  quantity           Int
  startDate          DateTime         @db.Date
  endDate            DateTime         @db.Date
  province           String
  siteAddress        String
  siteNotes          String?
  siteLatitude       Float?
  siteLongitude      Float?
  partnerAmount      Decimal          @db.Decimal(12, 2) // the partner's written quote for the whole job
  commissionPercent  Decimal          @db.Decimal(5, 2)
  customerTotal      Decimal          @db.Decimal(12, 2) // partnerAmount x (1 + commission)
  quoteSource        String // where the partner's quote is on record (email, PDF, rate card)
  quoteValidUntil    DateTime?
  preferredPartnerId String?
  preferredPartner   HirePartner?     @relation("PreferredPartner", fields: [preferredPartnerId], references: [id], onDelete: SetNull)
  assignedPartnerId  String?
  assignedPartner    HirePartner?     @relation("AssignedPartner", fields: [assignedPartnerId], references: [id], onDelete: SetNull)
  status             BookingStatus    @default(QUOTED)
  arrivalOtpHash     String? // sha256 of the 6-digit arrival code; the code itself is never stored
  otpFailures        Int              @default(0)
  paymentReference   String?
  termsVersion       String? // Plant Hire & Site Services Terms version the customer accepted with the quote
  customerRating     Int?
  cancelledReason    String?
  acceptedAt         DateTime?
  paidAt             DateTime?
  assignedAt         DateTime?
  startedAt          DateTime?
  completedAt        DateTime?
  closedAt           DateTime?
  createdById        String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  offers             DispatchOffer[]
  jobCards           JobCard[]
  messages           BookingMessage[]
  disputes           Dispute[]
  payout             PartnerPayout?

  isTest  Boolean  @default(false) // excluded from reporting
  refunds Refund[]

  @@index([status, createdAt])
  @@index([userId])
  @@index([assignedPartnerId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  WITHDRAWN
}

model DispatchOffer {
  id          String      @id @default(cuid())
  bookingId   String
  booking     Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     HirePartner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  rank        Int
  status      OfferStatus @default(PENDING)
  offeredAt   DateTime    @default(now())
  expiresAt   DateTime
  respondedAt DateTime?

  @@index([status, expiresAt])
  @@index([partnerId, status])
  @@index([bookingId])
}

/// The partner's daily record of the work: hours, hour meter or loads.
model JobCard {
  id             String   @id @default(cuid())
  bookingId      String
  booking        Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  workDate       DateTime @db.Date
  hoursWorked    Decimal? @db.Decimal(5, 2)
  startHourMeter Decimal? @db.Decimal(10, 1)
  endHourMeter   Decimal? @db.Decimal(10, 1)
  loads          Int?
  notes          String?
  createdById    String
  createdAt      DateTime @default(now())

  @@index([bookingId])
}

enum MessageSender {
  CUSTOMER
  PARTNER
  STAFF
}

/// In-platform chat; contact details are redacted before storage.
model BookingMessage {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  sender      MessageSender
  authorId    String
  body        String
  wasRedacted Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([bookingId, createdAt])
}

enum DisputeStatus {
  OPEN
  RESOLVED
}

enum DisputeOutcome {
  PAY_PARTNER
  REFUND_CUSTOMER
}

model Dispute {
  id           String          @id @default(cuid())
  bookingId    String
  booking      Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  raisedBy     MessageSender
  raisedById   String
  reason       String
  status       DisputeStatus   @default(OPEN)
  outcome      DisputeOutcome?
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())

  @@index([status])
}

enum PayoutStatus {
  PENDING // job not finished
  HELD // dispute window running
  DUE // window closed with no open dispute: staff pay by EFT
  PAID
  CANCELLED
}

model PartnerPayout {
  id            String       @id @default(cuid())
  bookingId     String       @unique
  booking       Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  partnerId     String
  partner       HirePartner  @relation(fields: [partnerId], references: [id])
  amount        Decimal      @db.Decimal(12, 2)
  status        PayoutStatus @default(PENDING)
  releaseAfter  DateTime?
  paidAt        DateTime?
  paidReference String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status, releaseAfter])
}

enum FlagSignal {
  REDACTION_HIT
  REPEAT_PAIR_STOPPED
}

enum FlagStatus {
  OPEN
  DISMISSED
  ACTIONED
}

/// Possible attempts to take a job off the platform — a review queue for staff, never an automatic penalty.
model CircumventionFlag {
  id         String     @id @default(cuid())
  signal     FlagSignal
  detail     String
  bookingId  String?
  partnerId  String?
  userId     String?
  status     FlagStatus @default(OPEN)
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([status, createdAt])
}

// ---------------------------------------------------------------------------
// Reporting & finance foundations (ANALYTICS.md, Phase 1)
// ---------------------------------------------------------------------------

enum CostSource {
  SNAPSHOT // captured from the pricing service at checkout
  ESTIMATED // backfilled from the price bands current when reporting started
}

enum DeliveryCostSource {
  ACTUAL // the haulier's amount, entered by staff
  STANDARD_RATE // the admin-set standard cost for the band and load
}

/// Admin-set standard cost of a delivery, ex VAT, by carrier, distance band and load ("BAGGED" for bagged/small deliveries).
model DeliveryCostRate {
  id        String            @id @default(cuid())
  carrier   Carrier
  bandLabel DeliveryBandLabel
  load      String // M3_6 | M3_10 | M3_14_PLUS | BAGGED
  costExVat Decimal           @db.Decimal(10, 2)
  updatedAt DateTime          @updatedAt

  @@unique([carrier, bandLabel, load])
}

/// Money returned to a customer for an order or booking (paid outside the platform by EFT).
model Refund {
  id          String   @id @default(cuid())
  orderId     String?
  order       Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bookingId   String?
  booking     Booking? @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  amount      Decimal  @db.Decimal(12, 2) // as paid back, VAT included where the sale included it
  reason      String
  reference   String? // bank / EFT reference
  refundedAt  DateTime
  createdById String
  createdAt   DateTime @default(now())

  @@index([refundedAt])
}

enum OperatingCostCategory {
  SALARIES
  RENT
  MARKETING
  SOFTWARE
  VEHICLES
  PROFESSIONAL_FEES
  BANK_CHARGES
  INSURANCE
  OTHER
}

/// Monthly operating costs entered by admins, ex VAT — for the management net P&L (not statutory accounts).
model OperatingCost {
  id          String                @id @default(cuid())
  month       DateTime              @db.Date // first day of the month
  category    OperatingCostCategory
  description String
  amountExVat Decimal               @db.Decimal(12, 2)
  createdById String
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  source      OperatingCostSource   @default(MANUAL)
  reference   String? // the accounting system's reference (account code, journal or invoice number) for imported rows

  @@index([month])
}

enum OperatingCostSource {
  MANUAL // entered on Admin → Finance
  IMPORT // imported from an accounting CSV export (re-importing a month replaces that month's imported rows)
}

/// A saved Admin → Insights view: a tab plus its filters. Private to its owner unless shared with all staff.
model InsightsView {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  path      String // the Insights tab, e.g. "products"
  query     String // the tab's filters as a query string (validated keys only)
  shared    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([shared])
}

/// One row per weekly insights email sent (the week's Monday, SAST) — claimed before sending so two API instances can't both send it.
model InsightsDigest {
  weekStart  DateTime  @id @db.Date
  claimedAt  DateTime  @default(now())
  sentAt     DateTime?
  recipients Int       @default(0)
  error      String?
}

// ---------------------------------------------------------------------------
// Cut & bend (STEEL_CATALOGUE.md, Phase S2): a customer's bar bending
// schedule — entered lines and/or an uploaded schedule file — totalled by
// SANS 920 nominal mass and priced by staff with a steel merchant. Nothing
// is charged until the customer accepts the written quote.
// ---------------------------------------------------------------------------

enum BendingScheduleStatus {
  NEW
  IN_REVIEW
  QUOTED
  ACCEPTED
  DECLINED
  CLOSED
}

model BendingSchedule {
  id              String                @id @default(cuid())
  reference       String                @unique // BBS-YYMMDD-XXXXXX, shown to the customer
  status          BendingScheduleStatus @default(NEW)
  userId          String? // signed-in customer, if any — only they can accept online
  contactName     String
  contactEmail    String
  contactPhone    String?
  companyName     String?
  projectName     String?
  province        String?
  siteAddress     String?
  requiredBy      DateTime? @db.Date
  message         String?
  lineCount       Int                   @default(0)
  totalMassKg     Decimal               @default(0) @db.Decimal(12, 2)
  fileStorageKey  String?               @unique
  fileName        String?
  fileContentType String?
  fileSizeBytes   Int?
  quotedAmount    Decimal?              @db.Decimal(12, 2)
  quoteNotes      String?
  quoteValidUntil DateTime?             @db.Date
  quotedAt        DateTime?
  respondedAt     DateTime?
  staffNotes      String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  lines           BendingScheduleLine[]

  @@index([status, createdAt])
  @@index([userId])
}

/// One schedule row: bar mark, SANS 282 shape code, bar type and size, how many, and the cut length of one bar.
model BendingScheduleLine {
  id            String          @id @default(cuid())
  scheduleId    String
  schedule      BendingSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  position      Int
  barMark       String
  member        String?
  barType       String // "Y" (450 MPa) or "R" (250 MPa)
  diameterMm    Int
  shapeCode     String
  members       Int // number of members
  barsPerMember Int
  lengthMm      Int // cut length of one bar
  massKg        Decimal         @db.Decimal(12, 3)

  @@index([scheduleId, position])
}
